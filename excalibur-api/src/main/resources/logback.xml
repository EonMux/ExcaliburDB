<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback configuration for ExcaliburDB structured logging.

    This configuration produces JSON-formatted logs suitable for log aggregation
    systems like Elasticsearch, Splunk, or Graylog. Correlation IDs are
    automatically included via MDC (Mapped Diagnostic Context).

    Usage:
    - Set correlation ID in MDC at request entry: MDC.put("correlationId", id)
    - Clear MDC in finally block: MDC.remove("correlationId")
    - Use StructuredLoggingHelper for safe MDC management

    Environment Variables:
    - EXCALIBUR_LOG_LEVEL: Root log level (default: INFO)

    Output is JSON. A human-readable switch used to be documented here and wired to nothing:
    logback selects an appender conditionally only with Janino, which this build does not carry,
    so the variable was read into a property no logger referenced and the dev appenders were
    constructed on every boot without ever writing a line. Pipe the JSON through a formatter for
    local reading, or add the dependency and make the switch real.
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!--
        Flush the appenders before the JVM goes away.

        The root appender below is asynchronous: a logging call hands the event to a queue and
        returns, and a worker thread writes it. That is the right trade for a server under load and
        the wrong one at the moment the server is dying, because System.exit() after a fatal
        startup error tears the JVM down while the error is still sitting in the queue. The
        symptom is a process that exits 1 having printed nothing at all. An unparseable
        EXCALIBUR_PORT did exactly that, while the bind-policy refusal on the next line of the same
        constructor happened to win the race and print.

        This hook stops the context on shutdown, which drains the queue first, so whichever error
        killed the process is the last thing written.
    -->
    <shutdownHook class="ch.qos.logback.core.hook.DefaultShutdownHook"/>

    <!-- Read log level from environment variable, default to INFO -->
    <property name="LOG_LEVEL" value="${EXCALIBUR_LOG_LEVEL:-INFO}" />

    <!-- Console appender with JSON format for production -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Include MDC fields in JSON output -->
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeMdcKeyName>queryId</includeMdcKeyName>
            <includeMdcKeyName>sourceId</includeMdcKeyName>
            <includeMdcKeyName>documentId</includeMdcKeyName>
            <includeMdcKeyName>segmentId</includeMdcKeyName>
            <includeMdcKeyName>stage</includeMdcKeyName>
            <includeMdcKeyName>threadName</includeMdcKeyName>

            <!-- Include context stack for nested operations -->
            <includeTags>true</includeTags>

            <!-- Timestamp format -->
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampPattern>

            <!-- Include exception stack traces -->
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>2048</maxLength>
                <shortenedClassNameLength>20</shortenedClassNameLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>

            <!-- Custom field names for clarity -->
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <level>level</level>
                <logger>logger</logger>
                <thread>thread</thread>
                <message>message</message>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
        </encoder>
    </appender>

    <!-- Async appender wrapper for better performance -->
    <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="JSON_CONSOLE" />
    </appender>

    <!-- Reduce noise from third-party libraries -->
    <logger name="org.slf4j" level="WARN" />
    <logger name="ch.qos.logback" level="WARN" />

    <!-- Root logger configuration -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="ASYNC_JSON" />
    </root>

</configuration>
