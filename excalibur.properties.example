# ExcaliburDB Configuration template.
# Disk-backed data relevancy retrieval engine for LLMs.
#
# Copy to excalibur.properties (gitignored) and edit. Every key below can also be supplied
# from the environment as EXCALIBUR_<KEY>, upper-cased with - and . replaced by _ , which
# overrides the file. Supply secrets that way rather than writing them into a file.

# Visibility Configuration
excalibur.visibility.epoch-tick-ms=100
excalibur.visibility.query-timeout-ms=30000

# Ingest Configuration
excalibur.ingest.document-atomicity-timeout-ms=2000
# Whether a document's chunks become visible together. Leave it on: off, a query can match half
# a document while the rest is still being written, which is a wrong answer rather than a slow one.
excalibur.ingest.document-atomicity=true
# How often a registered source is re-crawled on its own. One hour. A node with no embedding
# endpoint re-crawls too: it re-chunks what changed and re-indexes it lexically, and reports the
# run as `indexing` rather than `embedding`. Only the vectors are missing, which is one signal of
# several rather than the precondition for re-crawling at all.
excalibur.ingest.reindex-interval-ms=3600000
# The shortest gap a web crawl leaves between two requests to its host, in milliseconds. 200ms is
# five a second. A crawl is a sequential walk that makes two requests per page - one to read its
# links, one to fetch it - so without pacing a host behind a fast link is asked for pages as
# quickly as it will answer them, up to the ten million a single registration may ask for.
# A registration's own `crawl_delay_ms` may ask for a longer gap and never a shorter one: the rate
# a host is asked to bear is the deployment's decision. 0 turns pacing off entirely; the maximum
# is 60000, and a value outside that range is refused at startup rather than clamped.
excalibur.ingest.crawl-delay-ms=200

# How a document is split before it is indexed. The target is what one chunk aims for and the
# overlap is what it repeats from the chunk before it, both counted in tokens. Larger chunks carry
# more surrounding context into a single result; smaller ones rank more precisely, because a
# chunk's score is diluted by everything in it that the question did not ask about. The overlap is
# what keeps an answer that straddles a boundary from being split across two chunks that each hold
# half of it. Changing either only affects what is ingested or re-indexed afterwards: chunks
# already written keep the shape they were written with until their source is re-indexed.
excalibur.ingest.chunk-target-tokens=512
excalibur.ingest.chunk-overlap-tokens=64

# Membership Filter
# Entries the hierarchical Cuckoo filter is sized for. SIZE THIS TO YOUR CORPUS. The filter is
# what prunes segments that cannot hold a query's terms, and a filter with no room left cannot
# record a new term. A level that has refused one is no longer trusted to rule anything out, so
# pruning switches off for its scope and every query scans it: results stay correct and queries
# get slower. /v1/stats reports it as cuckoo.saturated. The only cost of over-sizing is memory.
# About twice this many slots are allocated, rounded up to a power of two: a cuckoo filter
# refuses inserts before its slots are full, so a filter sized to exactly its capacity would
# saturate at the corpus it was configured for.
excalibur.filter.corpus-capacity=10000000
# Distinct terms one segment's own level is sized for. Separate from the corpus capacity: that
# level holds every term on the node, this one holds a single segment's vocabulary. A segment
# that outgrows it stops being pruned, which /v1/stats counts as cuckoo.saturatedSegments.
excalibur.filter.segment-capacity=10000
# Bits of each term the filter keeps. This is the accuracy-for-memory trade it makes: every extra
# bit halves the chance two unrelated terms look alike, and so halves the segments a query opens
# for nothing, at one more bit per slot. 4 to 16; below that the filter stops ruling anything out,
# above it a fingerprint no longer fits the slot the format gives it.
excalibur.filter.fingerprint-bits=13

# API Server Configuration
# Port to listen on. EXCALIBUR_PORT in the environment overrides this; a value that is not a
# port number fails startup rather than quietly falling back to 8080.
excalibur.api.port=8080
# How long a stop may take, in seconds, from the signal to the last file closed. Every drain
# shares it, and its last 10 seconds are kept for publishing buffered chunks and persisting the
# registry. Work still running when the drains' share ends is left for the next start to
# recover. Set the supervisor's stop timeout (docker --stop-timeout, k8s
# terminationGracePeriodSeconds, systemd TimeoutStopSec) to at least this plus 10. 15 to 3600.
excalibur.api.shutdown-timeout-seconds=30
# The API binds to loopback by default. Binding any other address requires an explicit
# excalibur.api.bind-address, excalibur.api.auth-token, AND TLS; without them the server
# refuses to start rather than serving the network unauthenticated or in cleartext.
excalibur.api.bind-address=127.0.0.1
# Never set the auth token here. Supply it as the EXCALIBUR_API_AUTH_TOKEN environment
# variable, which is the environment override of this key. Setting it turns authentication on:
# every endpoint except GET /health and GET /health/ready then requires it as a bearer token (a
# method a path does not serve is still answered 405 without one). Unset, the API is unauthenticated -- which is safe only
# because the bind policy above will not let it listen anywhere but loopback without one.
#excalibur.api.auth-token=
# Per-client rate limits: separate budgets for reads and for mutating requests.
excalibur.api.read-rate-per-second=50
excalibur.api.read-burst=200
excalibur.api.mutate-rate-per-second=5
excalibur.api.mutate-burst=20
excalibur.api.rate-limit-max-clients=10000
# Hops whose X-Forwarded-For this node believes, as addresses or CIDR ranges. Empty means only
# the peer address is ever metered, which is right with nothing in front of the node and wrong
# behind a TLS-terminating proxy, where every caller shares the proxy's budget. Naming the proxy
# makes the rightmost entry of its forwarding header the unit charged -- the nearest hop the
# client could not have written. Never set it to a range you do not control: the header is
# whatever a caller types.
#excalibur.api.trusted-proxies=10.0.0.0/8,192.168.1.7
# Bounds applied to client-supplied query fields before they size anything server-side.
excalibur.api.max-top-k=1000
excalibur.api.max-query-timeout-ms=60000
# The query text is embedded, and on the lexical path expanded, so its length is an outbound
# call the caller sizes. The default is four times a chunk -- the largest unit anything in the
# index was embedded as.
excalibur.api.max-query-chars=8192
# Largest oversampling_factor a request may ask for. The factor multiplies top_k into the HNSW
# beam width, and the beam is what bounds how much of a segment a search walks, so leaving it
# unbounded lets one small request scan every candidate segment end to end.
excalibur.api.max-oversampling-factor=16

# Longest text returned for one chunk, whether by include_text on a query or by /v1/documents.
# A search asked for text returns top_k chunks in one body, and chunk size is set at ingestion
# (excalibur.ingest.chunk-target-tokens) rather than per request, so without this the response
# size is chosen by whoever ingested the corpus. Text past the bound is clipped and the reply
# says that it was.
excalibur.api.max-result-text-chars=4096

# Transport Security
# Setting a keystore turns TLS on. The keystore holds the server certificate and its
# private key; PKCS12 is the default format and the one keytool writes by default.
#excalibur.api.tls-keystore=/etc/excalibur/server.p12
# TLS is on when a keystore is set. This overrides that: false serves plaintext despite a
# configured keystore. Set it only where serving plaintext is what you mean.
#excalibur.api.tls-enabled=true
# Never set the keystore password here. Supply it as the
# EXCALIBUR_API_TLS_KEYSTORE_PASSWORD environment variable.
#excalibur.api.tls-keystore-password=
#excalibur.api.tls-keystore-type=PKCS12
# Only needed when the keystore holds more than one private key entry, or when the key
# entry has its own password (which PKCS12 does not support -- JKS does).
#excalibur.api.tls-key-alias=
#excalibur.api.tls-key-password=
# Protocols and suites, in server preference order. The defaults are TLS 1.3 and 1.2 with
# forward-secret AEAD suites only; override them only to narrow, not to widen.
#excalibur.api.tls-protocols=TLSv1.3,TLSv1.2
#excalibur.api.tls-cipher-suites=
# Mutual TLS: none, want, or need. Anything but none should name a truststore, otherwise
# client certificates are checked against the JVM default store, which trusts the public
# web CAs and so accepts a certificate from almost anyone.
#excalibur.api.tls-client-auth=none
#excalibur.api.tls-truststore=/etc/excalibur/clients.p12
#excalibur.api.tls-truststore-password=
#excalibur.api.tls-truststore-type=PKCS12
# Set this only when something in front of this process terminates TLS -- a sidecar or an
# ingress forwarding over loopback. It permits a non-loopback bind to serve cleartext,
# which otherwise refuses to start.
#excalibur.api.allow-plaintext=false

# Graph-RAG Configuration
# The root the graph stores live under, one subdirectory per namespace: namespace n serves
# <root>/n/graph and stages in <root>/n/graph-staging. Leave unset for the data directory, so a
# single-tenant node serves <data dir>/shared/graph. The route is registered either way: a node
# that has never built a graph answers POST /v1/graph/query with 503 and says a build is what is
# missing, which is a different statement from 404.
#excalibur.graph.path=
# Documents each retrieval signal contributes before fusion, and the token budget the
# serialised subgraph must fit into.
excalibur.graph.top-k=10
excalibur.graph.context-token-budget=2000
# Candidates the full-precision reranker reads per result it returns. Reranking can only reorder
# what it is given, so this is what lets an entity that term overlap ranked poorly be rescued by
# its vector. Each extra candidate is one more full-precision vector read.
excalibur.graph.rerank-over-fetch=4
# Abstention thresholds. Below these the endpoint declines rather than answering from evidence
# it does not trust -- an empty "answered" reads to a client as "nothing found", which is a
# different statement from "found something and did not believe it".
#
# The three min-* values below are defaults, not measurements. AbstentionCalibrator.calibrate
# fits all three together against queries whose answers were known and reports the precision and
# coverage they buy; Calibration.minScore/minSeparation/minMeanConfidence are what to copy here.
# Fitting them one at a time and combining the results gives a node stricter than any of the
# three fits measured, because the gates overlap.
#
# min-score is read on a unit relevance scale, for the entity the question named: the share of the
# question's BM25 term weight its description carries, counting only words the graph holds, or its
# vector similarity to the question once the exact rerank has run. 0.05 declines a named entity
# whose description carries almost none of what the question asks. min-separation is the gap
# between the two best entities sharing the name the question used, as a fraction of the best;
# 0.01 calls two that scored within one percent of each other ambiguous and hands them back to be
# chosen between.
excalibur.graph.min-score=0.05
excalibur.graph.min-separation=0.01
excalibur.graph.min-mean-confidence=0.3
excalibur.graph.max-ambiguous-candidates=5
# Divisor on the log-odds of the confidence an answer reports. 1.0 leaves it untouched, which is
# the honest default: the number a node reports is built from a ranking score by arithmetic, and
# whether it can be read as a probability is a question only labelled outcomes can answer.
# AbstentionCalibrator.fitTemperature answers it -- above 1.0 softens overconfident claims
# towards 0.5, below 1.0 sharpens underconfident ones -- and reports the calibration error before
# and after, so a value copied here is one that was measured to help. Accepted range is
# (0.0, 20.0]; the fit reports a result that reached 20.0 as not well posed, so check
# ConfidenceCalibration.wellPosed() before copying a number anywhere near it. Scaling changes
# only how strongly an answer is claimed: it cannot reorder results or turn an answer into a
# refusal, because the thresholds above are what decide that.
excalibur.graph.confidence-temperature=1.0
# Lucene RAM buffer per index. Named for the graph, but the ingestion pipeline's chunk index is
# sized from it too when that runs on the lucene engine, so a node with no graph still pays it -
# once per open index, not once per node.
excalibur.graph.ram-buffer-mb=16

# Extracting facts from ingested documents. Off by default: it is one chat-model call per
# document, the most expensive thing ingestion can do, and a node doing vector search should not
# pay for a graph it never asked for.
excalibur.graph.extraction-enabled=false
# Recorded on every fact this node extracts, so one extractor's output can be erased by version.
excalibur.graph.extractor-version=1
# Embed each entity's text at build time, so retrieval can rerank BM25's candidates against real
# vectors rather than stopping at term overlap. Costs one embedding call per batch of entities at
# build time, and only happens at all when an embedding endpoint is configured.
excalibur.graph.entity-vectors-enabled=true
# Relations that hold one value at a time: a new value closes the previous interval rather than
# sitting beside it. Empty by default, because closing an interval destroys information - a
# relation wrongly left multi-valued returns a stale extra answer, one wrongly superseded silently
# deletes a true fact ("authored" closing the previous book when someone writes another).
#excalibur.graph.single-valued-relations=employer,lives_in

# Graphs held open at once. A served store is thirteen memory mappings and a process has a finite
# number of them, so the least recently used graph is evicted to make room rather than the node
# running out at whatever unrelated allocation comes next.
excalibur.graph.max-open-namespaces=16
# Namespaces that override recency. A hot one is never evicted and spends a slot permanently; a
# cold one is evicted before any other, which is what a bulk import or an idle tenant wants.
# Naming the same namespace in both refuses to start, as does naming the shared one: it is
# pinned regardless.
#excalibur.graph.hot-namespaces=acme,globex
#excalibur.graph.cold-namespaces=archive

# When an erasure compaction becomes worthwhile. The ratio amortises the rewrite; the latency bound
# is what makes an obligation a promise rather than a tuning knob, since a single request on a large
# store would otherwise never reach the ratio.
excalibur.graph.erasure-tombstone-ratio=0.2
# Checked every tenth of this by a sweep over the open namespaces, so an obligation submitted to
# a node that then goes quiet is still discharged on time.
excalibur.graph.erasure-max-latency-seconds=3600

# Ingest Target Allow-Lists
# Empty means DISABLED, not unrestricted. Filesystem ingest may only read inside these
# absolute directories; a requested root_path is canonicalised first and must resolve
# inside one of them.
excalibur.ingest.allowed-roots=
# URL ingest may only crawl these hosts, and only over http/https. Hosts resolving to
# loopback, private, link-local or multicast addresses are refused regardless.
excalibur.ingest.allowed-hosts=
# Bound on concurrently registered ingestion sources. It bounds the source ids that documents
# may be supplied directly under as well: an id holding supplied documents is an id no crawl can
# be registered under, so an unbounded set of them would let one caller deny every likely id.
excalibur.ingest.max-sources=256

# Chunk Lexical Index
# Which engine indexes chunk text for BM25 retrieval. "native" is the engine's own inverted index:
# it stores postings only and reads a chunk's text back from storage when compaction needs it, so
# the corpus exists once. "lucene" keeps a second full copy of every chunk's text in a Lucene index.
# These are alternatives, not layers -- only the configured one is written, and switching engines
# leaves the other's directory behind without reading it, so the corpus has to be reingested.
# An unrecognised value fails startup rather than falling back, since the difference is only
# visible as queries answered from a corpus you did not build.
excalibur.ingest.lexical-engine=native
# When reclaiming erased chunks becomes worthwhile, for the native engine. The ratio amortises the
# rewrite; the latency bound is what makes an erasure an obligation rather than a preference, since
# a single erased chunk in a large corpus would otherwise never reach the ratio. Lucene ignores
# both and merges on its own schedule.
excalibur.ingest.lexical-tombstone-ratio=0.2
excalibur.ingest.lexical-max-latency-seconds=3600
# Segments tolerated before the smallest are merged. Every segment is a set of mappings and a
# search that must visit it, so the count is bounded rather than left to grow with the corpus.
excalibur.ingest.lexical-max-segments=16
# Longest a document published by a run still in progress waits to become searchable by BM25. A
# run also refreshes when it ends or is stopped. Each refresh publishes a segment on the native
# engine and reopens a reader on Lucene, which is why it is paced rather than per document; at
# least 1000.
excalibur.ingest.lexical-refresh-interval-ms=30000
# How BM25 scores a match. k1 is where a repeated term stops earning more: higher keeps rewarding
# repetition, 0 reduces term frequency to a yes-or-no. b is how much a match is discounted for the
# length of the chunk it was found in: 1 normalises fully by length, 0 not at all.
#
# What changing them costs depends on lexical-engine above. The native engine records both in the
# index and REFUSES to open one built under a different pair: the pair changes every score the
# corpus can produce, and with it every ranking and every threshold a deployment has calibrated
# against those rankings, so changing either means reingesting the corpus. The lucene engine
# applies them at query time and records nothing, so a change takes effect on the next query,
# over the index already on disk.
excalibur.ingest.bm25-k1=1.2
excalibur.ingest.bm25-b=0.75

# Health Configuration
excalibur.health.readiness-threshold=0.5
excalibur.health.healthy-threshold=0.9
excalibur.health.max-latency-ms=5000
# The share of volume capacity below which this node reports itself unready. Not a
# "disk is filling up" warning - that is the volumes block on /v1/stats - but the point past
# which the replacement segment a compaction or a rolling reindex writes can no longer be
# relied on to fit. Raise it on volumes that need more headroom than a rewrite of the largest
# segment; lower it on a deployment whose volumes sit deliberately full.
excalibur.health.min-free-disk-ratio=0.05

# Query Configuration
excalibur.query.top-k-default=100
# A score floor for requests that name no threshold of their own. 0.0 filters nothing, which is
# the built-in default and what this file keeps: a floor tuned on someone else's corpus silently
# drops every result scoring under it, and on a corpus whose scores run lower than the floor that
# is every result. Raise it once you have seen what your own queries score.
excalibur.query.threshold=0.0
# excalibur.query.threshold=0.3
excalibur.query.include-partial-segments=true
excalibur.query.vector-dimensions=1536
excalibur.query.llm-timeout-ms=60000
# What one query-expansion call is allowed, separate from the scoring call above. Expansion runs
# before the search it expands, inside a request a caller is holding open, so it has to be bounded
# by something smaller than the query budget rather than by the ingestion client's 60s. An
# expansion that does not arrive in time is skipped and the query runs on the words the caller
# actually typed, which is the answer it would have given anyway on a node with no chat model.
excalibur.query.expansion-timeout-ms=5000
# Whether a node that embeds its corpus also expands the BM25 half of a hybrid query. Off means
# the vector signal carries the meaning of the question and BM25 matches the words as typed,
# which is what a node with vectors has always done. On, the lexical half is expanded too, so it
# contributes the same recall it would on a node with no embeddings at all - at one extra chat
# call per query. Whether it pays depends on the corpus; excalibur-bench measures both.
excalibur.query.expand-hybrid-queries=false
# Whether a repeated identical query may be answered without searching again. Off: a cache is a
# bet that the same question arrives twice before the corpus moves, and whether it pays is a
# property of a deployment's traffic rather than something a default can know. Correctness does
# not rest on the bet - every lookup re-reads a fingerprint of the live corpus and an entry is
# served only to a lookup presenting the identical one - so an entry is discarded the moment
# anything it was computed against changes. A node with no cache takes no fingerprint at all.
excalibur.query.cache.enabled=false
# How many answers the cache may hold. Entries, not bytes: one entry is one answer, whose result
# list is bounded by excalibur.api.max-top-k, so the worst case is this many times that many
# result items. 1 to 1000000; a value outside that is refused rather than clamped, because this
# is the figure a deployment sizes its heap against.
excalibur.query.cache.max-entries=1024
# Whether a node holding both signals answers /v1/query from both. The BM25 index over the
# chunks is written, compacted and erasure-swept whether or not a query reads it, so leaving
# this on is what stops a node that has it from paying for an index it never consults. It
# changes what `score` means on that route: fused answers score by summed reciprocal rank, not
# by similarity, and the response says so in `retrieval`. Set it to false to get vector-only
# ranking back - which is what a deployment with a threshold tuned against cosine scores wants.
excalibur.query.hybrid-retrieval=true
# Which distance the vector index is built and searched with: cosine, l2 or inner_product. The
# choice belongs to the embedding model - cosine for the usual normalised models, inner_product
# where a vector's magnitude means something, l2 for a model trained against Euclidean distance.
# It is written into each graph's header when the graph is created, and a graph built under one
# metric refuses to open under another: the edges encode the neighbourhood the old metric saw, so
# searching them under a new one returns a quietly worse ranking rather than an error. Changing it
# means reindexing.
excalibur.query.distance-metric=cosine
# How the two signals are fused. The rank offset is what flattens the weight curve: raise it and a
# document ranked tenth by one signal counts nearly as much as one ranked first; lower it and the
# top of each list dominates. 60 is the value the method was published with. The over-fetch is how
# many times top_k each signal contributes before fusion - a document has to be in a signal's list
# to be fused at all, so this is what lets a result that is mediocre on one signal and excellent on
# the other survive to be ranked.
excalibur.query.rrf-k=60
excalibur.query.per-signal-over-fetch=3

# LLM Configuration
# The API root. The clients append the OpenAI paths themselves (/v1/embeddings,
# /v1/chat/completions), so a trailing /v1 here is stripped rather than duplicated -- both
# https://api.openai.com and https://api.openai.com/v1 work. Point it at any OpenAI-compatible
# endpoint: Ollama (http://localhost:11434), vLLM, TGI, LiteLLM.
excalibur.llm.base-url=https://api.openai.com/v1
# Never set the api key here. Supply it as the EXCALIBUR_LLM_API_KEY environment variable,
# so it cannot be committed or read out of the working directory.
#excalibur.llm.api-key=
excalibur.llm.chat-model=gpt-4o-mini
excalibur.llm.embedding-model=text-embedding-3-small
excalibur.llm.embeddings-dimensions=1536
# Whether a configured key is spent on embedding the corpus. Turning it off keeps the chat model
# and drops the embedding pass: documents are chunked, stored and term-indexed, and /v1/query
# answers from BM25 with the model spent on expanding the query. Worth it for a corpus of
# identifiers, error codes or DOIs, where the literal token is the match.
excalibur.llm.embeddings-enabled=true
excalibur.llm.timeout-ms=60000
excalibur.llm.max-retries=3
excalibur.llm.failure-threshold=5
excalibur.llm.cooldown-period-ms=60000
excalibur.llm.max-prompts-per-query=10
excalibur.llm.relevancy-threshold=0.3
excalibur.llm.max-batch-tokens=4000
excalibur.llm.retry-base-delay-ms=500

# Shard Configuration
excalibur.shard.segment-load-factor=0.7
excalibur.shard.default-ef-construction=128
excalibur.shard.default-ef-search=64
excalibur.shard.compaction-delay-ms=10000
excalibur.shard.hnsw-integration-queue-depth-limit=100000
# Neighbours an HNSW node keeps. More means better recall, a larger graph file and a slower build.
# Layer 0 is where the walk stops descending and becomes exhaustive, so it is given more; 0 means
# twice the value above it. Both are written into a graph's header when it is created and a graph
# already on disk keeps what it was built with, so these govern graphs built from here on.
excalibur.shard.default-max-connections=16
excalibur.shard.default-max-connections-layer0=0

# When a segment is worth rewriting, and how often the question is asked. A segment is compacted
# once this fraction of it is tombstoned, or once its write log passes the size below - the second
# is what keeps a segment that is appended to but never deleted from accumulating an unbounded
# log. The concurrency bound is what stops a burst of eligible segments from spending the whole
# machine on rewrites; it is 1 to 16, and a value outside that is refused at startup against the
# property name rather than aborting the boot with a message naming no key.
excalibur.shard.compaction-interval-ms=5000
# How often the index registry is reconciled with the storage engine's directory. The sweep is
# what notices a segment the engine created without announcing it, so this is the longest a new
# segment can stay unsearchable after it appears. Lower costs a directory listing more often;
# higher widens that window. Below the sweep's own floor it is refused rather than clamped.
excalibur.shard.segment-sync-interval-ms=1000
excalibur.shard.compaction-tombstone-ratio=0.2
excalibur.shard.compaction-write-log-mb=32
# How many segments the scheduled sweep will rewrite in one pass. They go one after another on a
# single thread, not at once, so this bounds how long a sweep lasts rather than how much of the
# machine it uses. POST /v1/compact is not subject to it and walks every live segment.
excalibur.shard.compaction-max-concurrent=4
# The same question for the vector graph, which reclaims deleted nodes by renumbering rather than
# by rewriting a log, and is therefore asked less often.
excalibur.shard.hnsw-compaction-interval-ms=60000
excalibur.shard.hnsw-compaction-tombstone-ratio=0.2

# The shape of each segment's LSH index, which narrows the candidates a vector search considers.
# More tables and more probes find more of the true neighbours and read more buckets; more hash
# functions make each bucket narrower. The shape is recorded in the tables a segment writes: a
# segment built under one shape is searched without the prefilter under another - slower, still
# correct - and the node says so in its log. Reindex to apply a new shape to an existing corpus.
# Bounded: at most 256 tables (each one allocates hash-functions x dimensions floats, per
# segment), at most 63 hash functions (the bucket key is packed into a long) and at most 64
# probes. A value past those is refused at startup rather than per segment, so a configuration
# mistake is not reported as a problem with what is already on disk.
excalibur.shard.lsh-hash-tables=15
excalibur.shard.lsh-hash-functions=16
excalibur.shard.lsh-probes=3

# Directories segments are placed across, beyond the data directory. Empty, the default, keeps
# every segment in the data directory. Naming volumes spreads new segments over them and the data
# directory together by a consistent hash of the segment id, so adding a volume later moves as few
# existing segments as possible. Every volume named here has to exist as a directory before the
# node starts, and has to stay mounted. A volume the node cannot find is refused rather than
# created: an unmounted volume silently replaced by an empty directory on the root filesystem is
# how a node loses part of its corpus and reports nothing. On restart the node also checks the
# catalog against what it actually scanned, and refuses to start when a segment the catalog
# records is on none of the volumes it can see.
#
# Two entries that name the same directory - a symlink, a relative path, one written with a
# ".." that walks out and back in - are refused at startup, naming both spellings: the ring
# would hand the same directory two shares and the spread would be silently wrong. A volume
# that resolves to the data directory is folded into it instead, because that one is always
# entry 0 and always takes a share anyway.
#
# Changing the set re-weights the ring for NEW segments only. Segments already on disk stay
# where they are, with their write-ahead logs and split children beside them; this engine does
# not rebalance an existing corpus across a changed volume set.
#excalibur.shard.volumes=/mnt/fast-1,/mnt/fast-2

# Whether a segment's product quantiser answers the first pass of a vector search. Off by default.
# On, candidates are scored from their quantised codes - several times cheaper per candidate and
# less accurate - and the survivors are then rescored against their full-precision vectors, so the
# ranking returned is exact. What the approximation can still cost is a document the first pass
# never shortlisted, and the oversample is what buys that back: it is how many candidates the
# quantised pass collects per result asked for.
excalibur.shard.pq-search-enabled=false
excalibur.shard.pq-oversample=4

# The shape every segment's codebook is trained to. A vector is split into pq-subspaces parts and
# each part is clustered to pq-centroids centroids, so the code is one byte per subspace. More
# subspaces means better recall and a larger index; high-dimensional embeddings need more of them
# to keep each part small enough for that many clusters to describe. Training runs while a segment
# is warming and nothing may query it, which is what pq-training-samples bounds - set it to 0 to
# train on every vector the segment holds. It must be at least pq-centroids: k-means cannot fill a
# codebook from fewer samples than it has centroids.
excalibur.shard.pq-subspaces=8
excalibur.shard.pq-centroids=256
excalibur.shard.pq-training-samples=100000
